# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
# Leave WEBHOOK_URL empty for polling mode (recommended for a simple VPS deploy).
WEBHOOK_URL=

# Database
# Local (SQLite, no server needed):  sqlite+aiosqlite:///./bot.db
# Docker/prod (Postgres):            postgresql+asyncpg://postgres:postgres@postgres:5432/tg_task_bot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tg_task_bot

# Redis
REDIS_URL=redis://redis:6379/0

# ── LLM Provider: mock | openai ─────────────────────────────────────────────
# mock   — no keys, keyword heuristics only (no real understanding).
# openai — any OpenAI-compatible endpoint via OPENAI_BASE_URL:
#   • Groq (cloud, free tier):  BASE_URL=https://api.groq.com/openai/v1
#                               MODEL=llama-3.3-70b-versatile   KEY=<groq key>
#   • Local Ollama:             BASE_URL=http://localhost:11434/v1
#                               MODEL=qwen2.5:7b                KEY=ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# App settings
APP_ENV=local
DEFAULT_TIMEZONE=Asia/Almaty
DEFAULT_DIGEST_TIME=18:00
# Verbose SQL logging (noisy) — keep off unless debugging the DB layer
SQL_ECHO=false

# Analysis settings
CONTEXT_MESSAGES_LIMIT=20
CLARIFICATION_COOLDOWN_HOURS=4
CLARIFICATION_MIN_CONFIDENCE=0.7
# How often (seconds) to retry messages saved while the LLM was unavailable
PENDING_RETRY_INTERVAL_SECONDS=300
