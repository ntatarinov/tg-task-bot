# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
# Leave WEBHOOK_URL empty for polling mode (recommended for a simple VPS deploy).
WEBHOOK_URL=
# Required for webhook mode outside APP_ENV=local. Any random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(16))"
WEBHOOK_SECRET=

# ── Access control (fail-closed) ────────────────────────────────────────────
# Comma-separated chat ids. An empty list means the bot ignores EVERY chat.
# Easiest way: add the bot to a group, write something there, then press Allow in the
# panel's Chats tab. Or add yourself to ADMIN_USER_IDS and send /chatid in the chat.
ALLOWED_CHAT_IDS=
# Comma-separated Telegram user ids allowed to change settings and delete history.
# To find yours, message @userinfobot. Blocked attempts also log chat_id and user_id.
ADMIN_USER_IDS=

# Database. SQLite needs no server and is the default. The docker-compose.*.yml files for
# a server set their own path, so this line stays as is there.
# Postgres (only with docker-compose.prod.yml): postgresql+asyncpg://postgres:postgres@postgres:5432/tg_task_bot
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Redis is optional: without it the bot falls back to the database.
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider: mock | openai ─────────────────────────────────────────────
# mock   — no keys, keyword heuristics only (no real understanding).
# openai — any OpenAI-compatible endpoint via OPENAI_BASE_URL:
#   • Groq (cloud, free tier):  BASE_URL=https://api.groq.com/openai/v1
#                               MODEL=openai/gpt-oss-120b       KEY=<groq key>
#   • Local Ollama:             BASE_URL=http://localhost:11434/v1
#                               MODEL=gemma4:26b                KEY=ollama
# Check any other model with scripts/eval_llm.py first (see docs/TEST_REPORT.md).
LLM_PROVIDER=openai
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Chat content goes to a third-party service ONLY if the data owner sets this to
# true. While it is false, messages are saved and wait in the queue, and nothing
# is sent. A local endpoint (Ollama) does not need this.
LLM_EXTERNAL_ALLOWED=false
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2500
# For a local "thinking" model (gemma4) set LLM_REASONING_EFFORT=none and
# LLM_MAX_OUTPUT_TOKENS=6000, otherwise answers are slow and cut off.
# Leave empty for cloud models: gpt-oss only accepts low, medium or high.
LLM_REASONING_EFFORT=

# App settings
# Anything other than "local" closes the dashboard and webhook when their secrets are empty.
APP_ENV=local
DEFAULT_TIMEZONE=Asia/Almaty
DEFAULT_DIGEST_TIME=18:00
# Verbose SQL logging (noisy) — keep off unless debugging the DB layer
SQL_ECHO=false

# ── Batched analysis ────────────────────────────────────────────────────────
# Defaults fit a free tier of about 8000 tokens per minute.
ANALYSIS_INTERVAL_SECONDS=60
ANALYSIS_BATCH_MAX_MESSAGES=30
ANALYSIS_BATCH_MAX_CHARS=4000
# A batch starts at this many waiting messages, or once the oldest has waited this long.
ANALYSIS_MIN_BATCH_MESSAGES=10
ANALYSIS_MAX_WAIT_SECONDS=300
# Unusable model answers shrink the batch; after this many, messages are set aside
# and reported in the digest.
ANALYSIS_MAX_ATTEMPTS=5
DIGEST_FLUSH_BATCHES=5

# Ask in the chat who takes a new task nobody claimed.
CLARIFICATIONS_ENABLED=true
CLARIFICATION_COOLDOWN_HOURS=4

# A digest missed because the bot was down is still sent within this window.
DIGEST_CATCHUP_HOURS=6

# ── Retention, in days. 0 keeps data forever ────────────────────────────────
# Unanalyzed messages are never deleted. Conclusions keep their links to Telegram.
# Note: enabling this deletes already stored old messages at the next hourly run.
MESSAGE_RETENTION_DAYS=0
# Raw Telegram updates hold personal data the bot does not otherwise need.
RAW_UPDATE_RETENTION_DAYS=0

# ── Settings panel ──────────────────────────────────────────────────────────
# python -m app.admin_panel, then http://localhost:8090. It does not start without
# a password. On a server reach it through an SSH tunnel; never open this port.
ADMIN_PANEL_PASSWORD=

# ── Web dashboard (optional) ────────────────────────────────────────────────
# Adds a "🌐 Открыть на сайте" button under /tasks that opens an interactive
# task list in the browser instead of flooding the chat with one message per
# task. Both values must be set or the button is hidden.
# DASHBOARD_SECRET — any random string, e.g. generate with:
#   python -c "import secrets; print(secrets.token_hex(16))"
DASHBOARD_SECRET=
# PUBLIC_BASE_URL — the HTTPS address the dashboard is reachable at,
# e.g. https://your-name.ngrok-free.app (see WINDOWS_SETUP.md for ngrok setup).
PUBLIC_BASE_URL=
# If you run `uvicorn app.main:app` ONLY to serve the dashboard, alongside a
# separate `python -m app.polling` process that already handles the bot and
# digests, set this to false for the dashboard process (as an env var, not
# here) so digests aren't sent twice:  $env:ENABLE_SCHEDULER="false"
ENABLE_SCHEDULER=true
